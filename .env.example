PORT=3000
DATABASE_PATH=./data/sred.db
UPLOADS_DIR=./uploads

# JWT signing — generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_TTL_SECONDS=3600

# WebAuthn — must match the tunnel domain you'll demo on.
# RP_ID is the bare hostname; ORIGIN is the full https URL.
RP_NAME=SR&ED Tracker
RP_ID=localhost
ORIGIN=http://localhost:3000

# Magic link configuration
INVITE_TTL_MINUTES=1440
RECOVERY_TTL_MINUTES=15
ADD_DEVICE_TTL_MINUTES=30
