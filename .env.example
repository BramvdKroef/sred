PORT=3000
DATABASE_PATH=./data/sred.db
UPLOADS_DIR=./uploads

# Structured-logging level threshold. Each log emit is a single JSON line on
# stdout (info/debug) or stderr (warn/error). Accepted values, lowest to
# highest, are: debug | info | warn | error. Default `info` covers boot,
# request, email-send, auth-replay, and migration events. Bump to `warn` for
# a quieter production tail, drop to `debug` when diagnosing a specific flow.
LOG_LEVEL=info

# Number of reverse-proxy hops to trust for X-Forwarded-For. Express uses this
# to derive req.ip, which the per-route rate limiters (login/register/recovery/
# refresh/invite) key on. Default 1 covers the common single-nginx/Caddy hop;
# bump to 2+ if nested behind Cloudflare → nginx → app, set to 0 for bare-metal
# (no proxy). Wrong value => every client shares one rate-limit bucket.
TRUST_PROXY=1

# JWT signing — generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=__REPLACE_WITH_RANDOM_HEX_AT_LEAST_32_CHARS__
JWT_TTL_SECONDS=3600

# Refresh tokens — rotated on use, default ~30 days
REFRESH_TTL_DAYS=30

# WebAuthn — must match the tunnel domain you'll demo on.
# RP_ID is the bare hostname; ORIGIN is the full https URL.
# ORIGIN accepts a comma-separated list of origins for multi-tunnel deploys
# (e.g. "https://app.example.com,https://preview.example.com"). All entries
# are pinned for WebAuthn verification. The first entry is used as the
# canonical origin for outbound magic links. In production every entry must
# start with https://.
RP_NAME=SR&ED Tracker
RP_ID=localhost
ORIGIN=http://localhost:3000

# Magic link configuration
INVITE_TTL_MINUTES=1440
RECOVERY_TTL_MINUTES=15
ADD_DEVICE_TTL_MINUTES=30

# SMTP — defaults target Mailpit on localhost (port 1025, no auth).
# Leave SMTP_HOST empty to disable email send (magic links still log to stdout).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SR&ED Tracker <no-reply@sred.local>
